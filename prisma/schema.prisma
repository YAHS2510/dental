// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Clinic Platform Models
// -----------------------------------------------------------------------------

model Clinic {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  postalCode  String?
  themeKey    String   @default("teal-serenity") // Links to theme.config.ts preset
  logoUrl     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  staffUsers   StaffUser[]
  patients     Patient[]
  services     Service[]
  appointments Appointment[]
  auditLogs    AuditLog[]
  chatSessions ChatSession[]

  @@index([slug])
}

enum StaffRole {
  ADMIN
  STAFF
  DOCTOR
  NURSE
  RECEPTIONIST
}

model StaffUser {
  id         String    @id @default(cuid())
  clinicId   String
  name       String
  email      String
  phone      String?
  role       StaffRole @default(STAFF)
  specialty  String?
  avatarUrl  String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relationships
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  auditLogs    AuditLog[]

  @@unique([clinicId, email])
  @@index([clinicId])
}

model Patient {
  id               String    @id @default(cuid())
  clinicId         String
  firstName        String
  lastName         String
  email            String?
  phone            String
  dateOfBirth      DateTime?
  gender           String?
  address          String?
  emergencyContact String?
  medicalNotes     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relationships
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([clinicId])
  @@index([phone])
}

model Service {
  id              String   @id @default(cuid())
  clinicId        String
  name            String
  description     String?
  durationMinutes Int      @default(30)
  price           Decimal  @default(0.0) @db.Decimal(10, 2)
  category        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([clinicId])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  DECLINED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  MANUAL
  AI_BOOKING
  WHATSAPP
  WEB_FORM
}

model Appointment {
  id              String            @id @default(cuid())
  clinicId        String
  patientId       String
  staffUserId     String?
  serviceId       String
  startTime       DateTime
  endTime         DateTime
  status          AppointmentStatus @default(PENDING)
  source          AppointmentSource @default(MANUAL)
  reason          String?
  notes           String?
  patientType     String?           @default("ADULT") // "ADULT" or "CHILD"
  childName       String?
  guardianName    String?
  preferredDoctor String?
  timeRange       String?
  contactMethod   String?           @default("PHONE") // "PHONE" or "WHATSAPP"
  consentAgreed   Boolean           @default(true)
  reminderSentAt  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relationships
  clinic    Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  staffUser StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  service   Service    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  auditLogs AuditLog[]

  @@index([clinicId, startTime])
  @@index([patientId])
  @@index([staffUserId])
  @@index([status])
  @@index([source])
  @@index([status, startTime, reminderSentAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  clinicId       String
  staffUserId    String?
  appointmentId  String?
  action         String   // e.g., APPOINTMENT_REQUESTED, APPOINTMENT_CONFIRMED, APPOINTMENT_DECLINED, SERVICE_CREATED, SERVICE_UPDATED
  entityType     String   // "Appointment", "Service", "Patient"
  entityId       String
  performedBy    String   // Staff member name, "System / Patient Online", "AI Booking Agent"
  details        String?
  previousValues Json?
  newValues      Json?
  createdAt      DateTime @default(now())

  // Relationships
  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  staffUser   StaffUser?   @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([entityType, entityId])
  @@index([appointmentId])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// AI Receptionist Chat & Transcripts
// -----------------------------------------------------------------------------

model ChatSession {
  id        String        @id @default(cuid())
  clinicId  String?
  visitorId String?
  startedAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  status    String        @default("ACTIVE") // ACTIVE, CLOSED, ESCALATED
  messages  ChatMessage[]
  clinic    Clinic?       @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([startedAt])
  @@index([status])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      String      // "user" | "assistant" | "system"
  content   String
  flagged   Boolean     @default(false) // e.g., flagged for medical advice attempt or emergency triage
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
}

